---
import BaseLayout from './BaseLayout.astro';
import ToolCallout from '../components/ToolCallout.astro';
import type { CollectionEntry } from 'astro:content';
import { tools } from '../data/tools.json';
import { AUTHOR } from '../data/author.ts';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string };

const { title, description, pubDate, updatedDate, tags = [], author, slug } = Astro.props;

// Pick the tools this post is actually about from its tags. Every review and
// comparison already tags the tool by name, so 20 of the 24 posts get a
// relevant card without anyone editing a single markdown file.
const tagSet = new Set(tags.map((t: string) => t.toLowerCase()));
const mentioned = tools.filter(tool => tagSet.has(tool.id)).slice(0, 2);

// pubDate / updatedDate are deliberately NOT rendered anywhere in the UI.
// They stay in the frontmatter for sorting, the sitemap and structured data only.
const siteUrl = 'https://aibuilderhub.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
// If the post's author matches the site's Person entity (the normal case),
// link the BlogPosting's author straight to that @id instead of duplicating
// the name/url pair - one Person record for search engines to trust.
const isSiteAuthor = author === AUTHOR.name;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  url: canonicalURL,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: isSiteAuthor
    ? { '@id': `${siteUrl}/#person-${AUTHOR.name.toLowerCase().replace(/\s+/g, '-')}` }
    : { '@type': 'Person', name: author },
  publisher: { '@id': `${siteUrl}/#organization` },
  keywords: tags.join(', '),
};
---

<BaseLayout title={title} description={description} type="article">
  <!-- Structured data: BlogPosting -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- Reading progress bar -->
  <div id="reading-progress" class="progress-bar" aria-hidden="true"></div>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12">

    <!-- Affiliate disclosure notice -->
    <div class="disclosure-notice">
      <span class="font-bold shrink-0 mt-0.5" style="color: var(--color-accent);">ℹ</span>
      <span>
        This article may contain affiliate links. We only recommend tools we have personally tested.&#32;
        <a href="/disclosure" class="hover:underline ml-1" style="color: var(--color-accent-light);">Full disclosure →</a>
      </span>
    </div>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
    )}

    <!-- Title -->
    <h1 class="text-3xl sm:text-5xl font-extrabold leading-tight tracking-tight mb-4" style="color: var(--color-text);">{title}</h1>

    <!-- Meta bar (no dates by design — see comment in the frontmatter above) -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm mb-8 pb-8 divider" style="color: var(--color-muted);">
      {isSiteAuthor ? (
        <a href="/about" class="flex items-center gap-2 hover:underline" style="color: var(--color-muted);">
          <img
            src={AUTHOR.photo}
            alt={AUTHOR.name}
            width="24"
            height="24"
            class="rounded-full object-cover"
            loading="lazy"
          />
          <span>By {author}</span>
        </a>
      ) : (
        <span>By {author}</span>
      )}
    </div>

    <!-- Article content -->
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    <!-- Tools this post is about -->
    {mentioned.length === 0 && (
      <aside class="card not-prose mt-10 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm m-0" style="color: var(--color-prose-body);">
          Comparing what these tools cost before you commit?
        </p>
        <a href="/pricing" class="btn-secondary py-1.5 px-3 text-xs whitespace-nowrap">
          See the pricing table →
        </a>
      </aside>
    )}

    {mentioned.length > 0 && (
      <section class="mt-10" aria-label="Tools mentioned in this post">
        <h2 class="text-sm font-semibold uppercase tracking-wide mb-3" style="color: var(--color-muted);">
          Tools in this post
        </h2>
        {mentioned.map(tool => (
          <ToolCallout
            id={tool.id}
            name={tool.name}
            price={tool.price}
            bestFor={tool.bestFor}
            notFor={tool.notFor}
            reviewSlug={tool.reviewSlug}
            currentSlug={slug}
          />
        ))}
      </section>
    )}

    <!-- Author box -->
    {isSiteAuthor && (
      <div class="mt-12 pt-8 divider">
        <div class="card p-5 flex items-start gap-4">
          <img
            src={AUTHOR.photo}
            alt={AUTHOR.name}
            width="56"
            height="56"
            class="rounded-full object-cover shrink-0"
            loading="lazy"
          />
          <div>
            <p class="font-semibold m-0" style="color: var(--color-text);">{AUTHOR.name}</p>
            <p class="text-xs mb-2 m-0" style="color: var(--color-muted);">{AUTHOR.role}</p>
            <p class="text-sm m-0" style="color: var(--color-prose-body);">{AUTHOR.shortBio}</p>
            {AUTHOR.sameAs.length > 0 && (
              <div class="flex flex-wrap gap-3 mt-2 text-xs">
                {AUTHOR.sameAs.map(link => (
                  <a href={link.url} class="hover:underline" style="color: var(--color-accent-light);" target="_blank" rel="noopener noreferrer">
                    {link.label} →
                  </a>
                ))}
                <a href={`mailto:${AUTHOR.email}`} class="hover:underline" style="color: var(--color-accent-light);">
                  Email →
                </a>
              </div>
            )}
          </div>
        </div>
      </div>
    )}

    <!-- Post-article CTA -->
    <div class="mt-12 pt-8 divider">
      <div class="card p-6 text-center">
        <h3 class="font-semibold text-lg mb-1" style="color: var(--color-text);">Get our weekly AI builder digest</h3>
        <p class="text-sm mb-4" style="color: var(--color-muted);">New reviews, comparison updates, and builder tips every Tuesday.</p>
        <form
          id="post-newsletter-form"
          class="flex gap-2 max-w-sm mx-auto"
          data-newsletter-form
        >
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            class="input flex-1"
          />
          <!-- Honeypot: hidden from humans, filled in by naive bots -->
          <input type="text" name="website" tabindex="-1" autocomplete="off"
                 aria-hidden="true" class="hp-field" />
          <button type="submit" class="btn-primary whitespace-nowrap">Subscribe</button>
        </form>
        <p class="text-xs mt-2" style="color: var(--color-muted);">No spam. Unsubscribe anytime.</p>
        <p id="post-msg" data-newsletter-msg class="text-xs mt-2 hidden" style="color: var(--color-success);"></p>
      </div>
    </div>

  </article>
</BaseLayout>

<script is:inline>
  (function () {
    function updateProgress() {
      const bar = document.getElementById('reading-progress');
      if (!bar) return;
      const doc = document.documentElement;
      const total = doc.scrollHeight - doc.clientHeight;
      const pct = total > 0 ? (doc.scrollTop / total) * 100 : 0;
      bar.style.width = pct + '%';
    }
    document.addEventListener('scroll', updateProgress, { passive: true });
    document.addEventListener('astro:page-load', updateProgress);
    updateProgress();
  })();
</script>
