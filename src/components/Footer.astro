---
const year = new Date().getFullYear();
---

<footer class="divider mt-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">

    <!-- Newsletter signup. Shares the delegated [data-newsletter-form]
         listener defined once in BaseLayout. -->
    <div class="pb-8 mb-8 divider">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="font-semibold text-base mb-1" style="color: var(--color-text);">
            Weekly AI builder digest
          </h3>
          <p class="text-xs max-w-sm" style="color: var(--color-muted);">
            New reviews and comparison updates every Tuesday. No spam, unsubscribe anytime.
          </p>
        </div>

        <div class="w-full sm:w-auto">
          <form class="flex gap-2 sm:w-80" data-newsletter-form>
            <label for="footer-email" class="sr-only">Email address</label>
            <input
              type="email"
              id="footer-email"
              name="email"
              placeholder="your@email.com"
              required
              class="input flex-1"
            />
            <!-- Honeypot: hidden from humans, filled in by naive bots -->
            <input type="text" name="website" tabindex="-1" autocomplete="off"
                   aria-hidden="true" class="hp-field" />
            <button type="submit" class="btn-primary whitespace-nowrap">Subscribe</button>
          </form>
          <p class="text-xs mt-2" style="color: var(--color-muted);">
            By subscribing you agree to our&#32;
            <a href="/privacy" style="color: var(--color-accent-light);" class="hover:underline">Privacy Policy</a>.
          </p>
          <p data-newsletter-msg class="text-xs mt-1 hidden"></p>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">

      <div>
        <div class="flex items-center gap-1 mb-1 font-bold">
          <span style="color: var(--color-accent);">AI</span>
          <span style="color: var(--color-text);">BuilderHub</span>
        </div>
        <p class="text-xs max-w-xs" style="color: var(--color-muted);">
          Honest reviews of AI app builders, vibe coding tools, and no-code platforms.
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm" style="color: var(--color-muted);">
        <a href="/blog"        class="hover:opacity-100 transition-opacity opacity-80 hover:underline">Reviews</a>
        <a href="/tools"       class="hover:opacity-100 transition-opacity opacity-80 hover:underline">Tools</a>
        <a href="/pricing"     class="hover:opacity-100 transition-opacity opacity-80 hover:underline">Pricing</a>
        <a href="/about"       class="hover:opacity-100 transition-opacity opacity-80 hover:underline">About</a>
        <a href="/disclosure"  class="hover:opacity-100 transition-opacity opacity-80 hover:underline">Disclosure</a>
        <a href="/privacy"     class="hover:opacity-100 transition-opacity opacity-80 hover:underline">Privacy</a>
        <a href="/rss.xml"     class="hover:opacity-100 transition-opacity opacity-80 hover:underline">RSS</a>
      </nav>
    </div>

    <div class="mt-8 pt-6 divider flex flex-col sm:flex-row justify-between items-center gap-2 text-xs" style="color: var(--color-muted);">
      <span>© {year} AIBuilderHub. All rights reserved.</span>
      <span>
        Contains affiliate links –&#32;
        <a href="/disclosure" style="color: var(--color-accent-light);" class="hover:underline">full disclosure</a>
      </span>
    </div>
  </div>
</footer>
