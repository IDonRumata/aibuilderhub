---
interface Props {
  title: string;
  description: string;
  slug: string;
  tags?: string[];
}

const { title, description, slug, tags = [] } = Astro.props;
---

<article class="card flex flex-col group">
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mb-3">
      {tags.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}
    </div>
  )}

  <a href={`/blog/${slug}`} class="card-title-link">
    <h3 class="font-semibold text-base leading-snug mb-2">{title}</h3>
  </a>

  <p class="text-sm leading-relaxed flex-1 mb-4" style="color: var(--color-muted);">{description}</p>

  <div class="flex items-center justify-end pt-3 divider">
    <a href={`/blog/${slug}`} class="link-accent text-xs font-medium">
      Read →
    </a>
  </div>
</article>
