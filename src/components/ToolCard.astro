---
interface Props {
  id: string;
  name: string;
  description: string;
  price: string;
  badge?: string;
  reviewSlug?: string;
  rating?: number;
  /** true when this card links to a paying partner rather than the vendor */
  monetised?: boolean;
}

const { id, name, description, price, badge, reviewSlug, rating } = Astro.props;
const stars = rating ? Array.from({ length: 5 }, (_, i) => i < rating) : null;

// Outbound links always go through /go/<id>. The redirect target lives in
// src/data/tools.json, so switching a tool to an affiliate programme never
// touches a template or a published post.
const outboundHref = `/go/${id}`;
---

<div class="card flex flex-col">
  <div class="flex items-start justify-between mb-3">
    <div>
      <h3 class="font-semibold text-base" style="color: var(--color-text);">{name}</h3>
      {stars && (
        <div class="flex gap-0.5 mt-1">
          {stars.map(filled => (
            <span style={filled ? 'color: #FBBF24;' : 'color: var(--color-border);'} aria-hidden="true">★</span>
          ))}
        </div>
      )}
    </div>
    {badge && <span class="tag shrink-0">{badge}</span>}
  </div>

  <p class="text-sm leading-relaxed flex-1 mb-4" style="color: var(--color-muted);">{description}</p>

  <div class="flex items-center justify-between pt-3 divider">
    <span class="text-xs" style="color: var(--color-muted);">{price}</span>
    <div class="flex gap-2">
      {reviewSlug && (
        <a href={`/blog/${reviewSlug}`} class="btn-secondary py-1.5 px-3 text-xs">Review</a>
      )}
      <a
        href={outboundHref}
        target="_blank"
        rel="nofollow sponsored noopener"
        data-tool={id}
        class="btn-primary py-1.5 px-3 text-xs"
      >
        Try free →
      </a>
    </div>
  </div>
</div>
