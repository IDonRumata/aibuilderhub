# Copy to automation/.env for local runs. Never commit the real file.

# Required.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Without it the pipeline uses the local lexical embedder for
# semantic deduplication, which needs no key and works offline.
# VOYAGE_API_KEY=

# Optional overrides.
# AIBH_MODEL=claude-sonnet-5
# AIBH_LOG_LEVEL=INFO
