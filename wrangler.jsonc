{
  // The custom domain aibuilderhub.app is served by a Cloudflare Worker of this
  // name, built from this repository by Workers Builds on every push to main.
  // Its deploy command is `npx wrangler deploy`, and without this file wrangler
  // has to guess what kind of project this is.
  //
  // It guessed wrong. Finding an Astro project and no configuration, wrangler
  // pulled @astrojs/cloudflare at whatever version was newest, injected it as an
  // SSR adapter and rebuilt the site through it. That adapter does not match the
  // astro version pinned in package-lock.json, so every deploy since 3 September
  // died on the same line:
  //
  //   [MISSING_EXPORT] "renderForPrerender" is not exported by
  //   node_modules/astro/dist/core/app/entrypoints/index.js
  //   at node_modules/@astrojs/cloudflare/dist/utils/prerender.js
  //
  // The build step itself always succeeded, so GitHub looked healthy and the
  // posts of 3, 7 and 9 September sat in main returning 404 to readers.
  //
  // This site has no server-side rendering: `astro build` emits static files and
  // no _worker.js. Declaring that here removes the guess. An assets-only Worker
  // needs no `main`, no adapter and no node compatibility flags, so there is no
  // second build to go out of step with the lockfile.
  "name": "aibuilderhub",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    // Astro emits every page as <route>/index.html, and the site's canonical
    // URLs carry the trailing slash. Keep both spellings resolving.
    "html_handling": "auto-trailing-slash",
    // Astro builds a real 404 page; serve it instead of a bare status line.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
